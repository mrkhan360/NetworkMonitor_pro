name: Build Network Monitor EXE

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install psutil pyinstaller

      - name: Build EXE
        run: |
          pyinstaller --noconfirm --clean --onefile --windowed --name NetworkMonitorPro network_monitor.py

      - name: Upload EXE
        uses: actions/upload-artifact@v4
        with:
          name: NetworkMonitorPro-Windows
          path: dist/NetworkMonitorPro.exe
